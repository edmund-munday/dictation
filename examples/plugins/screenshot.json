{
  "name": "screenshot",
  "description": "Take a screenshot and copy it to the clipboard. Name a subject to crop to it, or capture the whole screen without one.",
  "enabled": true,
  "triggers": ["take a screenshot", "take a screenshot of {subject}", "grab a screenshot", "grab a screenshot of {subject}", "screenshot", "screenshot this", "screenshot that", "screenshot the {subject}", "screenshot that {subject}"],
  "args": {
    "subject": {
      "type": "string",
      "required": false,
      "description": "what to capture, e.g. the Slack window or error dialog",
      "ignore_words": ["um", "uh", "er", "like", "so", "just", "please", "this", "that", "it", "here", "there", "the", "a", "an", "my", "whole", "entire", "full", "screen", "everything", "now"]
    }
  },
  "action": {"type": "exec", "path": "bin/snip-capture.py", "argv": []},
  "timeout_s": 15,
  "timeout_with_args_s": 40,
  "confirm_delay_s": 0
}
