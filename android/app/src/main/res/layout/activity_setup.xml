<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dictation keyboard"
            android:textColor="#1C1B19"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/keyboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Keyboard: checking"
            android:textColor="#1C1B19"
            android:textSize="16sp" />

        <Button
            android:id="@+id/enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable keyboard"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/microphone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Microphone: checking"
            android:textColor="#1C1B19"
            android:textSize="16sp" />

        <Button
            android:id="@+id/grant_microphone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant microphone"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Recogniser"
            android:textColor="#1C1B19"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/recogniser_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/recogniser_android"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android on-device" />

            <RadioButton
                android:id="@+id/recogniser_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="whisper.cpp small.en q5" />

            <RadioButton
                android:id="@+id/recogniser_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="whisper.cpp base.en q5" />
        </RadioGroup>

        <TextView
            android:id="@+id/model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Models: checking"
            android:textColor="#1C1B19"
            android:textSize="15sp" />

        <Button
            android:id="@+id/download_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download small.en q5"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/download_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download base.en q5"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Fields that expose Send"
            android:textColor="#1C1B19"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/probe_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No fields seen yet."
            android:textColor="#1C1B19"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bench"
            android:textColor="#1C1B19"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/bench_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1C1B19"
            android:textSize="16sp" />

        <Button
            android:id="@+id/record_take"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/bench_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1C1B19"
            android:textSize="15sp" />

        <Button
            android:id="@+id/export_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export results"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
